{
  "name": "android-qa-playwright-suite",
  "version": "1.0.0",
  "description": "Playwright (TypeScript) UI + API regression suite for a device QA / OTA management portal",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:api": "playwright test tests/api-regression.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
